<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="PolySharp" Version="1.17.1" />
  </ItemGroup>
  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.12.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="TUnit" Version="1.87.12" />
  </ItemGroup>
  <ItemGroup Label="Source generator">
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.14.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" Version="1.1.4" />
    <PackageVersion
      Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing"
      Version="1.1.4"
    />
    <!-- Overrides vulnerable transitive version from Microsoft.CodeAnalysis.Analyzer.Testing -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Source generator runtime dependencies">
    <PackageVersion Include="System.Text.Json" Version="11.0.0" />
    <PackageVersion Include="Microsoft.Bcl.HashCode" Version="6.0.0" />
  </ItemGroup>
  <Choose>
    <When Condition="'$(TargetFramework)' == 'net11.0'">
      <ItemGroup>
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
      </ItemGroup>
    </When>
    <When Condition="'$(TargetFramework)' == 'net10.0'">
      <ItemGroup>
        <PackageVersion
          Include="Microsoft.Extensions.DependencyInjection.Abstractions"
          Version="10.0.15"
        />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.15" />
      </ItemGroup>
    </When>
    <Otherwise>
      <ItemGroup>
        <PackageVersion
          Include="Microsoft.Extensions.DependencyInjection.Abstractions"
          Version="11.0.0"
        />
        <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="11.0.0" />
        <PackageVersion Include="System.Collections.Immutable" Version="11.0.0" />
      </ItemGroup>
    </Otherwise>
  </Choose>
</Project>
