<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Analyzer.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.SourceGenerators.Testing" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\UaDetector.SourceGenerator\UaDetector.SourceGenerator.csproj" />
  </ItemGroup>

  <!--
    The generator returns its netstandard2.0 dependencies (System.Memory, System.Text.Json, ...) from
    GetTargetPath so they load beside it as analyzers. As references here they clash with the
    in-box net11.0 assemblies, so keep only the generator assembly itself.
  -->
  <Target Name="ReferenceOnlyGeneratorAssembly" AfterTargets="ResolveProjectReferences">
    <ItemGroup>
      <_ResolvedProjectReferencePaths
        Remove="@(_ResolvedProjectReferencePaths)"
        Condition="'%(Filename)' != 'UaDetector.SourceGenerator'"
      />
    </ItemGroup>
  </Target>
</Project>
